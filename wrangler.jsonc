{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scs-shindan",
  "compatibility_date": "2026-06-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    { "pattern": "scs-shindan.com", "custom_domain": true }
  ]
}
